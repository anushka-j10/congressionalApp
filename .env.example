# Local OCR is the default. Set vision explicitly to send images to OpenAI.
# Options for explicit comparison/selection: tesseract, preprocessed, vision, hybrid.
TEXT_READER=preprocessed
TESSERACT_CMD=tesseract
# Required for extraction and for vision/hybrid reading. Choose a vision-capable model in your account.
OPENAI_API_KEY=
OPENAI_MODEL=

# Hosted mode requires one exact HTTPS origin (Render supplies RENDER_EXTERNAL_URL).
# Leave these unset for localhost development; no secrets belong here.
# APP_ENV=production
# PUBLIC_ORIGIN=https://your-service.onrender.com
